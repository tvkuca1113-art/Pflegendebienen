---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SituationSelector from '../components/SituationSelector.astro';
import CostsAndSteps from '../components/CostsAndSteps.astro';
import AreaCheck from '../components/AreaCheck.astro';
import OwnerStrip from '../components/OwnerStrip.astro';
import SocialStrip from '../components/SocialStrip.astro';
import Faq from '../components/Faq.astro';
import ContactCta from '../components/ContactCta.astro';
import Recruitment from '../components/Recruitment.astro';
import { FAQ } from '../data/faq';
import { faqGraph, serviceGraph } from '../lib/schema';

const title = 'Ambulanter Pflegedienst München-West & Germering | Pflegende Bienen';
const description =
  'Pflege, Behandlungspflege und Alltagshilfe zu Hause in München-West und Germering. Sagen Sie uns, was gebraucht wird – wir klären den nächsten Schritt mit Ihnen.';
---

<Base
  title={title}
  description={description}
  path="/"
  crumbs={[{ name: 'Startseite', path: '/' }]}
  schema={[faqGraph([...FAQ]), ...serviceGraph()]}
>
  <Hero />
  <SituationSelector />
  <CostsAndSteps />
  <AreaCheck />
  <OwnerStrip />
  <SocialStrip />
  <Faq
    items={FAQ}
    title="Häufige Fragen"
    intro="Das hören wir am Telefon am häufigsten. Wenn Ihre Frage hier nicht dabei ist, rufen Sie uns einfach an – wir beantworten sie gern persönlich."
  />
  <ContactCta />
  <Recruitment />
</Base>
