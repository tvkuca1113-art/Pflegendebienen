---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import OfficeCards from '../components/OfficeCards.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Icon from '../components/Icon.astro';
import { CONTACT, OWNERS, SOCIAL, LEGAL_HEADQUARTERS, BRAND } from '../data/business';

const crumbs = [
  { name: 'Startseite', path: '/' },
  { name: 'Kontakt', path: '/kontakt/' },
];

/* Phone, WhatsApp and an e-mail draft are the working contact routes. A
   callback form is prepared in the codebase but stays out of the interface
   until a real delivery destination is configured — see HANDOVER.md. */
const mailSubject = encodeURIComponent('Anfrage zu Ihrem Pflegeangebot');
const mailBody = encodeURIComponent(
  'Guten Tag,\n\nich möchte mich über Ihr Pflegeangebot informieren.\n\n' +
    'Ort:\nGewünschte Unterstützung:\nGewünschter Beginn:\n\n' +
    'Mit freundlichen Grüßen\n',
);
const mailDraftHref = `${CONTACT.emailHref}?subject=${mailSubject}&body=${mailBody}`;
---

<Base
  title="Kontakt | Pflegende Bienen – Pflegedienst München & Germering"
  description="Telefon 089 54637889, WhatsApp und E-Mail: So erreichen Sie die Pflegenden Bienen. Adressen der Büros in München-West und Germering."
  path="/kontakt/"
  crumbs={crumbs}
>
  <PageHeader
    eyebrow="Kontakt"
    title="So erreichen Sie uns"
    intro="Am besten rufen Sie uns an – dann können wir Ihre Situation direkt besprechen. Alternativ erreichen Sie uns über WhatsApp oder per E-Mail."
    crumbs={crumbs}
  />

  <div class="section">
    <div class="shell">
      <div class="channels">
        <article class="channel channel--primary">
          <Icon name="phone" size={26} />
          <h2 class="channel__title">Telefon</h2>
          <p class="channel__value">
            <a href={CONTACT.phoneHref}>{CONTACT.phoneDisplay}</a>
          </p>
          <p class="channel__text">
            Der direkteste Weg. Sie müssen nichts vorbereiten – schildern Sie einfach, worum es
            geht.
          </p>
          <a class="btn" href={CONTACT.phoneHref}>Jetzt anrufen</a>
        </article>

        <article class="channel">
          <Icon name="whatsapp" size={26} />
          <h2 class="channel__title">WhatsApp</h2>
          <p class="channel__value">
            <a href={CONTACT.whatsappHref} target="_blank" rel="noopener noreferrer">
              {CONTACT.whatsappDisplay}
            </a>
          </p>
          <p class="channel__text">
            Kurze Fragen gern per Nachricht. Gesundheitliche Details besprechen wir lieber
            telefonisch.
          </p>
          <a class="btn btn--outline" href={CONTACT.whatsappHref} target="_blank" rel="noopener noreferrer">
            Chat öffnen
          </a>
        </article>

        <article class="channel">
          <Icon name="mail" size={26} />
          <h2 class="channel__title">E-Mail</h2>
          <p class="channel__value">
            <a href={CONTACT.emailHref}>{CONTACT.email}</a>
          </p>
          <p class="channel__text">
            Schreiben Sie uns, wann wir Sie am besten erreichen. Wir melden uns zurück.
          </p>
          <a class="btn btn--outline" href={mailDraftHref}>Rückruf per E-Mail anfragen</a>
        </article>
      </div>

      <section class="offices-block" aria-labelledby="offices-title">
        <h2 id="offices-title">Büros für ein persönliches Gespräch</h2>
        <p class="offices-block__intro">
          Bitte melden Sie sich vor einem Besuch kurz telefonisch an, damit jemand für Sie da ist.
        </p>
        <OfficeCards />
        <p class="offices-block__hq">
          <strong>Sitz laut Impressum:</strong> {LEGAL_HEADQUARTERS.street},{' '}
          {LEGAL_HEADQUARTERS.postalCode} {LEGAL_HEADQUARTERS.locality}. Das ist die
          Geschäftsanschrift von {BRAND.legalName} und kein Büro für Besuche.
        </p>
      </section>

      <section class="further" aria-labelledby="further-title">
        <h2 id="further-title">Weitere Kontakte</h2>
        <dl class="further__list">
          <div>
            <dt>Organisation &amp; interne Abläufe</dt>
            <dd>
              {OWNERS.dusko.name} ·{' '}
              <a href={`mailto:${OWNERS.dusko.email}`}>{OWNERS.dusko.email}</a> ·{' '}
              <a href={OWNERS.dusko.mobileHref}>{OWNERS.dusko.mobileDisplay}</a>
            </dd>
          </div>
          <div>
            <dt>Fax</dt>
            <dd>{CONTACT.faxDisplay}</dd>
          </div>
          <div>
            <dt>Social Media</dt>
            <dd>
              <a href={SOCIAL.instagram} target="_blank" rel="noopener noreferrer">Instagram</a> ·{' '}
              <a href={SOCIAL.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>
            </dd>
          </div>
        </dl>
        <p class="further__hint">
          Für Pflegeanfragen ist die Bürorufnummer {CONTACT.phoneDisplay} der richtige Weg.
        </p>
      </section>

      <RelatedLinks
        links={[
          { label: 'Alle Leistungen', href: '/leistungen/' },
          { label: 'Kosten & Finanzierung', href: '/kosten-finanzierung/' },
          { label: 'Über uns', href: '/ueber-uns/' },
          { label: 'Impressum', href: '/impressum/' },
        ]}
      />
    </div>
  </div>
</Base>

<style>
  .channels { display: grid; gap: 1.25rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .channel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    padding: clamp(1.4rem, 3vw, 2rem);
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
  }
  .channel--primary {
    background: linear-gradient(180deg, #fffdf8 0%, #fdf1de 100%);
    border-color: var(--brand-edge);
  }
  .channel svg { color: var(--brand); }
  .channel__title { font-size: var(--step-1); margin: 0.35rem 0 0; }
  .channel__value { margin: 0; font-size: var(--step-1); font-weight: 700; }
  .channel__value a { color: var(--ink); text-decoration: none; border-bottom: 2px solid var(--brand); }
  .channel__value a:hover { color: var(--brand-ink); }
  .channel__text { margin: 0.3rem 0 1rem; color: var(--ink-body); font-size: var(--step--1); flex: 1; }


  .offices-block { margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .offices-block__intro { max-width: 66ch; color: var(--ink-body); margin-bottom: 1.75rem; }
  .offices-block__hq {
    margin: 1.5rem 0 0;
    font-size: var(--step--1);
    color: var(--ink-body);
    max-width: 66ch;
  }

  .further { margin-bottom: clamp(2rem, 4vw, 3rem); }
  .further__list { margin: 1.5rem 0 0; display: grid; gap: 1.1rem; }
  .further__list > div {
    padding-left: 1.1rem;
    border-left: 2px solid var(--brand-edge);
  }
  .further__list dt { font-weight: 700; font-size: var(--step--1); margin-bottom: 0.25em; }
  .further__list dd { margin: 0; color: var(--ink-body); font-size: var(--step--1); }
  .further__hint { margin-top: 1.5rem; font-size: var(--step--1); color: var(--olive); }

  @media (min-width: 820px) {
    .channels { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .further__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
