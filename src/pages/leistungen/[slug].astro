---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import ContactPanel from '../../components/ContactPanel.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import ContactCta from '../../components/ContactCta.astro';
import { SERVICES } from '../../data/services';
import { SERVICE_AREA, CONTACT } from '../../data/business';
import { abs, ORGANIZATION_ID } from '../../lib/schema';

export function getStaticPaths() {
  return SERVICES.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;

const crumbs = [
  { name: 'Startseite', path: '/' },
  { name: 'Leistungen', path: '/leistungen/' },
  { name: service.navLabel, path: service.path },
];

const serviceSchema = {
  '@type': 'Service',
  '@id': abs(`${service.path}#leistung`),
  name: service.h1.split(':')[0]!.trim(),
  serviceType: service.navLabel,
  description: service.metaDescription,
  url: abs(service.path),
  provider: { '@id': ORGANIZATION_ID },
  areaServed: [
    ...SERVICE_AREA.munichDistricts.map((n) => ({ '@type': 'Place', name: `${n}, München` })),
    ...SERVICE_AREA.surroundingPlaces.map((n) => ({ '@type': 'Place', name: n })),
  ],
};
---

<Base
  title={service.metaTitle}
  description={service.metaDescription}
  path={service.path}
  crumbs={crumbs}
  schema={[serviceSchema]}
>
  {/* Benefit-led opening: what this does for you, then the concrete examples. */}
  <div class="lede">
    <div class="shell">
      <Breadcrumbs crumbs={crumbs} />
      <div class="lede__grid">
        <div class="lede__text">
          <span class="eyebrow">{service.eyebrow}</span>
          <h1>{service.h1}</h1>
          <p class="lead lede__line">{service.lede}</p>
          <div class="btn-row lede__actions">
            <a class="btn" href={CONTACT.phoneHref}>
              <Icon name="phone" size={19} />
              {CONTACT.phoneDisplay}
            </a>
            <a class="btn btn--outline" href="#kontakt">Rückruf anfragen</a>
          </div>
        </div>

        {service.photo ? (
          <figure class="lede__figure">
            <Photo
              src={service.photo.src}
              alt={service.photo.alt}
              width={760}
              height={570}
              sizes="(min-width: 980px) 46vw, 100vw"
              priority={true}
              class="lede__image"
              position="50% 45%"
            />
            <figcaption>{service.photo.caption}</figcaption>
          </figure>
        ) : (
          <aside class="lede__card">
            <h2 class="lede__card-title">Das übernehmen wir</h2>
            <ul class="chips lede__chips">
              {service.highlights.map((h) => <li>{h}</li>)}
            </ul>
            {service.legalBasis && <p class="lede__basis">{service.legalBasis}</p>}
          </aside>
        )}
      </div>
    </div>
  </div>

  <div class="section">
    <div class="shell service__layout">
      <div class="service__main">
        <section aria-labelledby="umfang">
          <h2 id="umfang">{service.scope.heading}</h2>
          {service.scope.note && <p class="service__note">{service.scope.note}</p>}
          <ul class="ticks service__scope">
            {service.scope.items.map((i) => <li>{i}</li>)}
          </ul>
        </section>

        <section class="service__block" aria-labelledby="wann">
          <h2 id="wann">{service.whenRelevant.heading}</h2>
          <ul class="service__cases">
            {service.whenRelevant.items.map((i) => <li>{i}</li>)}
          </ul>
        </section>

        <section class="prose service__block" aria-labelledby="was">
          <h2 id="was">{service.whatItMeans.heading}</h2>
          {service.whatItMeans.paragraphs.map((p) => <p>{p}</p>)}
        </section>

        <section class="service__block service__funding" aria-labelledby="kosten">
          <h2 id="kosten">{service.funding.heading}</h2>
          <p>{service.funding.paragraphs[0]}</p>
          <p class="service__link">
            <a class="link-action" href="/kosten-finanzierung/">Kosten &amp; Finanzierung im Detail</a>
          </p>
        </section>

        <section class="service__block service__ask" aria-labelledby="fragen">
          <h2 id="fragen">So läuft die Anfrage</h2>
          <p class="service__note">
            Rufen Sie an und schildern Sie Ihre Situation. Wir besprechen, welche Unterstützung
            infrage kommt und was dafür geklärt werden muss. Einen Termin nennen wir Ihnen, sobald
            wir Ihren Bedarf und Ihren Ort kennen.
          </p>
          <h3 class="service__ask-title">Diese Fragen helfen beim ersten Gespräch</h3>
          <ul class="ticks">
            {service.questionsToPrepare.map((q) => <li>{q}</li>)}
          </ul>
        </section>

        <RelatedLinks links={[...service.related]} />
      </div>

      <div class="service__aside">
        <ContactPanel />
      </div>
    </div>
  </div>

  <ContactCta
    title="Passt diese Leistung zu Ihrer Situation?"
    text="Rufen Sie an oder bitten Sie um einen Rückruf – wir ordnen es gemeinsam ein."
  />
</Base>

<style>
  .lede { background: var(--paper); border-bottom: 1px solid var(--hairline); padding-bottom: clamp(1.75rem, 4vw, 3rem); }
  .lede__grid { display: grid; gap: clamp(1.5rem, 3.5vw, 3rem); align-items: center; padding-top: clamp(1rem, 2.5vw, 2rem); }
  .lede__line { max-width: 42ch; }
  .lede__actions { margin-top: 1.5rem; }

  .lede__figure { margin: 0; }
  .lede__image { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 22px 22px 22px 0; box-shadow: var(--shadow-photo); }
  .lede__figure figcaption { margin-top: 0.5rem; color: var(--olive); font-size: 0.8125rem; }

  .lede__card {
    padding: clamp(1.35rem, 3vw, 2rem);
    border-radius: 22px 22px 22px 0;
    background: var(--brand-soft);
  }
  .lede__card-title { font-size: var(--step-1); margin-bottom: 0.8em; }
  .lede__chips { margin-bottom: 1.1rem; }
  .lede__chips li { background: rgba(255, 255, 255, 0.75); font-weight: 600; }
  .lede__basis { margin: 0; color: var(--brand-ink); font-size: var(--step--1); }

  .service__layout { display: grid; gap: clamp(2rem, 4vw, 3.5rem); align-items: start; }
  .service__main { min-width: 0; }
  .service__block { margin-top: clamp(2.25rem, 4vw, 3rem); max-width: var(--measure); }
  .service__note { color: var(--ink-body); font-size: var(--step--1); max-width: 66ch; }

  .service__cases { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.7rem; }
  .service__cases li {
    margin: 0;
    padding: 0.9rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    font-size: var(--step--1);
  }

  .service__funding { padding: clamp(1.2rem, 2.5vw, 1.6rem); background: var(--sage); border-radius: var(--radius-lg); }
  .service__funding h2 { margin-top: 0; font-size: var(--step-2); }
  .service__link { margin: 0.9rem 0 0; }

  .service__ask { padding: clamp(1.4rem, 3vw, 2rem); background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--radius-lg); }
  .service__ask h2 { margin-top: 0; }
  .service__ask-title { margin: 1.5em 0 0.7em; font-size: 0.8rem; letter-spacing: 0.11em; text-transform: uppercase; color: var(--olive); }

  @media (min-width: 860px) {
    .lede__grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); }
  }
  @media (min-width: 980px) {
    .service__layout { grid-template-columns: minmax(0, 1fr) 330px; gap: 4rem; }
  }
</style>
