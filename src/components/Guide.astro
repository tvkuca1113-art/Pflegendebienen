---
import { GUIDE_OPTIONS, GUIDE_AREA_MATCH, GUIDE_AREA_NO_MATCH } from '../data/guide';
import { SERVICE_AREA, CONTACT } from '../data/business';
import Icon from './Icon.astro';
---

{/* Orientation guide. No name, e-mail or phone number is required to see any
    of the information, nothing is transmitted anywhere, and no availability or
    medical decision is made here. Without JavaScript every answer is simply
    visible at once. */}
<section class="guide section" id="orientierung" aria-labelledby="guide-title">
  <div class="shell">
    <div class="guide__head">
      <span class="eyebrow">Orientierung</span>
      <h2 id="guide-title">Welche Unterstützung brauchen Sie gerade?</h2>
      <p class="lead">
        Wählen Sie aus, was am ehesten zutrifft. Sie sehen dann die passende Leistung, eine kurze
        Erklärung und Fragen, die ein erstes Telefonat leichter machen. Sie müssen dafür keine
        Daten angeben.
      </p>
    </div>

    <div class="guide__engine">
      <fieldset class="guide__fieldset">
        <legend class="guide__legend">Ihre Situation</legend>
        <div class="guide__options">
          {GUIDE_OPTIONS.map((opt, i) => (
            <div class="guide__option">
              <input
                type="radio"
                name="guide-choice"
                id={`guide-${opt.id}`}
                value={opt.id}
                class="guide__radio"
                data-guide-radio
              />
              <label for={`guide-${opt.id}`} class="guide__label">
                <span class="guide__num">{i + 1}</span>
                <span>{opt.label}</span>
              </label>
            </div>
          ))}
        </div>
      </fieldset>

      <div class="guide__results" data-guide-results aria-live="polite">
        <div class="guide__placeholder" data-guide-placeholder hidden>
          <p class="guide__placeholder-lead">
            Wählen Sie eine Situation aus, um die passende Antwort zu sehen.
          </p>
          <p class="guide__placeholder-text">
            Dieser Überblick ersetzt kein Gespräch und trifft keine Entscheidung über Ihren Anspruch
            oder über freie Kapazitäten. Er hilft nur dabei, das Telefonat vorzubereiten.
          </p>
          <p class="guide__placeholder-text">
            Lieber gleich sprechen? <a href={CONTACT.phoneHref}>{CONTACT.phoneDisplay}</a>
          </p>
        </div>

        {GUIDE_OPTIONS.map((opt) => (
          <article class="guide__result" data-guide-result={opt.id} aria-labelledby={`result-${opt.id}`}>
            <h3 id={`result-${opt.id}`} class="guide__result-title">{opt.resultTitle}</h3>
            <p>{opt.resultText}</p>

            <h4 class="guide__prepare-title">Diese Fragen helfen beim Telefonat</h4>
            <ul class="check-list guide__prepare">
              {opt.prepare.map((q) => <li>{q}</li>)}
            </ul>

            <div class="guide__result-actions">
              <a class="btn btn--sm" href={CONTACT.phoneHref}>
                <Icon name="phone" size={18} />
                {CONTACT.phoneDisplay} anrufen
              </a>
              <a class="arrow-link" href={opt.primaryLink.href}>{opt.primaryLink.label}</a>
              {opt.secondaryLink && (
                <a class="arrow-link" href={opt.secondaryLink.href}>{opt.secondaryLink.label}</a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>

    {/* Optional area check — published service area only, never live capacity. */}
    <div class="guide__area">
      <div class="guide__area-field">
        <label class="guide__area-label" for="ort-select">
          Optional: Gehört Ihr Ort zu unserem Einsatzgebiet?
        </label>
        <select id="ort-select" class="guide__select" data-area-select>
          <option value="">Ort auswählen</option>
          <optgroup label="München">
            {SERVICE_AREA.munichDistricts.map((d) => (
              <option value={d} data-match="1">{d}</option>
            ))}
          </optgroup>
          <optgroup label="Umland">
            {SERVICE_AREA.surroundingPlaces.map((d) => (
              <option value={d} data-match="1">{d}</option>
            ))}
          </optgroup>
          <option value="__other">Mein Ort steht nicht in der Liste</option>
        </select>
      </div>
      <p class="guide__area-result" data-area-result role="status">
        Die Liste zeigt die auf unserer Website veröffentlichten Orte. Eine Aussage über freie
        Kapazitäten ist damit nicht verbunden.
      </p>
    </div>
  </div>
</section>

<style>
  .guide { background: var(--paper-2); border-block: 1px solid var(--stone); }
  .guide__head { max-width: 62ch; margin-bottom: clamp(2rem, 4vw, 3rem); }

  .guide__engine { display: grid; gap: clamp(1.5rem, 3vw, 2.5rem); align-items: start; }

  .guide__fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  .guide__legend { padding: 0; margin-bottom: 0.9rem; font-weight: 700; font-size: var(--step--1); color: var(--ink-soft); }

  .guide__options { display: grid; gap: 0.7rem; }
  .guide__option { position: relative; }

  .guide__radio {
    position: absolute;
    width: 1px; height: 1px;
    opacity: 0;
    margin: 0;
  }

  .guide__label {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-height: 56px;
    padding: 0.85rem 1.1rem;
    background: var(--surface);
    border: 1.5px solid var(--stone);
    border-radius: var(--radius);
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.15s var(--ease), background-color 0.15s var(--ease),
      box-shadow 0.15s var(--ease);
  }
  .guide__label:hover { border-color: #c6ae86; box-shadow: var(--shadow-sm); }

  .guide__num {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--brand-wash);
    color: var(--brand-deep);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .guide__radio:checked + .guide__label {
    border-color: var(--brand);
    background: #fffdf8;
    box-shadow: 0 0 0 1px var(--brand), var(--shadow-sm);
  }
  .guide__radio:checked + .guide__label .guide__num { background: var(--brand); color: var(--ink); }
  .guide__radio:focus-visible + .guide__label { outline: 3px solid var(--brand-ink); outline-offset: 3px; }

  .guide__results { display: grid; gap: 1.25rem; }

  .guide__placeholder {
    padding: clamp(1.3rem, 3vw, 1.9rem);
    border: 1.5px dashed #cbb694;
    border-radius: var(--radius-lg);
    color: var(--ink-soft);
    background: #fffdf8;
  }
  .guide__placeholder-lead {
    font-weight: 700;
    font-size: var(--step-0);
    color: var(--ink);
    margin-bottom: 0.8em;
  }
  .guide__placeholder-text { font-size: var(--step--1); margin-bottom: 0.8em; }
  .guide__placeholder-text:last-child { margin-bottom: 0; }
  .guide__placeholder-text a { font-weight: 700; }

  .guide__result {
    background: var(--surface);
    border: 1px solid var(--stone);
    border-left: 4px solid var(--brand);
    border-radius: var(--radius-lg);
    padding: clamp(1.3rem, 3vw, 1.9rem);
  }
  html.js .guide__result[hidden],
  html.js .guide__placeholder[hidden] { display: none; }

  .guide__result-title { color: var(--brand-deep); margin-bottom: 0.5em; }
  .guide__prepare-title {
    margin: 1.5em 0 0.7em;
    font-size: 0.78rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .guide__prepare { margin-bottom: 1.4em; }

  .guide__result-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1.4rem;
  }

  .guide__area {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    padding: clamp(1.2rem, 3vw, 1.75rem);
    background: var(--brand-wash);
    border: 1px solid var(--brand-wash-2);
    border-radius: var(--radius-lg);
    display: grid;
    gap: 1rem;
  }
  .guide__area-label { display: block; font-weight: 700; margin-bottom: 0.5rem; }
  .guide__select {
    width: 100%;
    max-width: 24rem;
    min-height: 50px;
    padding: 0.6rem 0.85rem;
    border: 1.5px solid #9a8a70;
    border-radius: 10px;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: var(--step-0);
  }
  .guide__area-result { margin: 0; color: var(--brand-deep); font-size: var(--step--1); line-height: 1.6; }
  .guide__area-result[data-state='match'] { font-weight: 600; }

  @media (min-width: 880px) {
    .guide__engine { grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr); gap: 2.5rem; }
    .guide__area { grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr); align-items: center; gap: 2.5rem; }
  }
</style>

<script is:inline define:vars={{ MATCH: GUIDE_AREA_MATCH, NO_MATCH: GUIDE_AREA_NO_MATCH }}>
  const radios = document.querySelectorAll('[data-guide-radio]');
  const results = document.querySelectorAll('[data-guide-result]');
  const placeholder = document.querySelector('[data-guide-placeholder]');

  if (radios.length && results.length) {
    const show = (id) => {
      results.forEach((el) => {
        el.hidden = el.getAttribute('data-guide-result') !== id;
      });
      if (placeholder) placeholder.hidden = Boolean(id);
    };
    // Enhance: collapse to the placeholder only once JS is confirmed running.
    show(null);
    radios.forEach((r) => r.addEventListener('change', () => show(r.value)));
  }

  const select = document.querySelector('[data-area-select]');
  const areaResult = document.querySelector('[data-area-result]');
  if (select && areaResult) {
    const base = areaResult.textContent;
    select.addEventListener('change', () => {
      const opt = select.selectedOptions[0];
      if (!select.value) {
        areaResult.textContent = base;
        areaResult.removeAttribute('data-state');
      } else if (opt && opt.dataset.match === '1') {
        areaResult.textContent = MATCH;
        areaResult.setAttribute('data-state', 'match');
      } else {
        areaResult.textContent = NO_MATCH;
        areaResult.setAttribute('data-state', 'other');
      }
    });
  }
</script>
