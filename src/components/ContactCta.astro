---
import { CONTACT, OFFICES, fullAddress } from '../data/business';
import Icon from './Icon.astro';

interface Props { title?: string; text?: string; id?: string }
const {
  title = 'Lassen Sie uns Ihren nächsten Schritt klären.',
  text = 'Ein Anruf genügt, um Ihre Fragen und die Möglichkeiten zu besprechen.',
  id = 'kontakt',
} = Astro.props;

/* The e-mail action opens a draft in the visitor's own mail programme. It is
   labelled as a request, never as a submitted web form, and nothing is sent
   until the person sends it themselves. */
const mailHref =
  `${CONTACT.emailHref}?subject=${encodeURIComponent('Rückruf erbeten')}` +
  `&body=${encodeURIComponent('Guten Tag,\n\nbitte rufen Sie mich zurück.\n\nName:\nTelefon:\nOrt:\n\nVielen Dank.')}`;
---

<section class="cta on-dark" id={id} aria-labelledby={`${id}-title`}>
  <div class="shell cta__inner">
    <div class="cta__main">
      <h2 id={`${id}-title`}>{title}</h2>
      <p class="lead">{text}</p>
      <p class="cta__intro">
        Sie erreichen uns unter der Bürorufnummer. Wir hören zu, ordnen Ihre Situation ein und
        sagen Ihnen offen, was wir übernehmen können und was nicht.
      </p>

      <a class="btn cta__call" href={CONTACT.phoneHref}>
        <Icon name="phone" size={20} />
        {CONTACT.phoneDisplay} anrufen
      </a>

      <div class="cta__alt">
        <p class="cta__alt-title">Lieber schreiben?</p>
        <div class="btn-row">
          <a class="btn btn--onDark btn--sm" href={mailHref}>
            <Icon name="mail" size={18} />
            Rückruf per E-Mail anfragen
          </a>
          <a class="btn btn--onDark btn--sm" href={CONTACT.whatsappHref} target="_blank" rel="noopener noreferrer">
            <Icon name="whatsapp" size={18} />
            WhatsApp
          </a>
        </div>
        <p class="cta__hint">
          Gesundheitliche Details besprechen wir am besten telefonisch, nicht per Nachricht.
        </p>
      </div>
    </div>

    <ul class="cta__offices">
      {OFFICES.map((o) => (
        <li>
          <strong>{o.label}</strong>
          <address>{fullAddress(o)}</address>
          <a href={o.directionsUrl} target="_blank" rel="noopener noreferrer">Route planen</a>
        </li>
      ))}
      <li class="cta__mail">
        <strong>E-Mail</strong>
        <a href={CONTACT.emailHref}>{CONTACT.email}</a>
      </li>
    </ul>
  </div>
</section>

<style>
  .cta { padding-block: clamp(2.75rem, 6vw, 5rem); }
  .cta__inner { display: grid; gap: clamp(2rem, 4vw, 3.5rem); align-items: start; }
  .cta__main { max-width: 46ch; }
  .cta__intro { margin-top: 1rem; color: #c3cbbc; font-size: var(--step--1); }
  .cta__call { margin: 1.75rem 0 2rem; }

  .cta__alt { padding-top: 1.5rem; border-top: 1px solid rgba(255, 255, 255, 0.18); }
  .cta__alt-title { margin-bottom: 0.8rem; color: #fffdf8; font-weight: 700; }
  .cta__hint { margin: 1rem 0 0; color: #c3cbbc; font-size: var(--step--1); }

  .cta__offices { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem; }
  .cta__offices li { margin: 0; padding-left: 1rem; border-left: 2px solid var(--brand); }
  .cta__offices strong { display: block; margin-bottom: 0.25rem; color: #fffdf8; }
  .cta__offices address { font-style: normal; color: #c3cbbc; font-size: var(--step--1); }
  .cta__offices a { display: inline-flex; align-items: center; min-height: 44px; color: #f4f6f1; font-size: var(--step--1); font-weight: 700; }
  .cta__offices a:hover { color: var(--brand); }
  .cta__mail a { word-break: break-word; }

  @media (min-width: 900px) {
    .cta__inner { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 4rem; }
  }
</style>
