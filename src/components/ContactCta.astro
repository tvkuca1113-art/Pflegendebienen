---
import { CONTACT, OFFICES, fullAddress } from '../data/business';
import Icon from './Icon.astro';
import CallbackForm from './CallbackForm.astro';

interface Props { title?: string; text?: string; id?: string }
const {
  title = 'Lassen Sie uns Ihren nächsten Schritt klären.',
  text = 'Rufen Sie an oder bitten Sie um einen Rückruf – wir melden uns.',
  id = 'kontakt',
} = Astro.props;
---

<section class="cta on-dark" id={id} aria-labelledby={`${id}-title`}>
  <div class="shell cta__inner">
    <div class="cta__main">
      <h2 id={`${id}-title`}>{title}</h2>
      <p class="lead">{text}</p>

      <a class="btn cta__call" href={CONTACT.phoneHref}>
        <Icon name="phone" size={20} />
        {CONTACT.phoneDisplay} anrufen
      </a>

      <ul class="cta__details">
        {OFFICES.map((o) => (
          <li>
            <strong>{o.label}</strong>
            <address>{fullAddress(o)}</address>
            <a href={o.directionsUrl} target="_blank" rel="noopener noreferrer">Route planen</a>
          </li>
        ))}
        <li>
          <strong>E-Mail</strong>
          <a href={CONTACT.emailHref}>{CONTACT.email}</a>
        </li>
        <li>
          <strong>WhatsApp</strong>
          <a href={CONTACT.whatsappHref} target="_blank" rel="noopener noreferrer">
            {CONTACT.whatsappDisplay}
          </a>
          <p class="cta__hint">Gesundheitliche Details besprechen wir lieber am Telefon.</p>
        </li>
      </ul>
    </div>

    <div class="cta__form">
      <h3 class="cta__form-title">Rückruf anfragen</h3>
      <p class="cta__form-text">Drei Angaben genügen. Keine Diagnosen, keine Unterlagen.</p>
      <CallbackForm />
    </div>
  </div>
</section>

<style>
  .cta { padding-block: clamp(2.75rem, 6vw, 5rem); }
  .cta__inner { display: grid; gap: clamp(2rem, 4vw, 3.5rem); align-items: start; }
  .cta__main { max-width: 40ch; }
  .cta__call { margin: 1.5rem 0 2rem; }

  .cta__details { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  .cta__details li { margin: 0; padding-left: 1rem; border-left: 2px solid var(--brand); }
  .cta__details strong { display: block; margin-bottom: 0.2rem; color: #fffdf8; }
  .cta__details address { font-style: normal; color: #c9cbbf; font-size: var(--step--1); }
  .cta__details a {
    display: inline-flex; align-items: center; min-height: 44px;
    color: #f4f2ea; font-size: var(--step--1); font-weight: 700;
  }
  .cta__details a:hover { color: var(--brand); }
  .cta__hint { margin: 0.1rem 0 0; color: #a9ab9f; font-size: 0.85rem; }

  .cta__form {
    padding: clamp(1.35rem, 3vw, 2rem);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.04);
  }
  .cta__form-title { margin-bottom: 0.3em; font-size: var(--step-2); }
  .cta__form-text { margin-bottom: 1.3em; color: #c9cbbf; font-size: var(--step--1); }

  @media (min-width: 960px) {
    .cta__inner { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 4rem; }
  }
</style>
