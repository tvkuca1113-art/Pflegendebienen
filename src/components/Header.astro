---
import { MAIN_NAV } from '../data/navigation';
import { CONTACT, BRAND } from '../data/business';
import Icon from './Icon.astro';

interface Props { path: string }
const { path } = Astro.props;

const isActive = (href: string) =>
  path === href || (href !== '/' && path.startsWith(href.replace(/\/$/, '')));
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand" href="/" aria-label={`${BRAND.name} – zur Startseite`}>
      {/* Original logo, unmodified pixels, natural 195×120 aspect ratio. */}
      <img
        src="/logo-original.png"
        width="195"
        height="120"
        alt={BRAND.name}
        class="brand__logo"
        fetchpriority="high"
      />
    </a>

    <nav class="nav" aria-label="Hauptnavigation">
      <ul class="nav__list">
        {MAIN_NAV.map((item) => (
          <li class={item.children ? 'nav__item nav__item--has-sub' : 'nav__item'}>
            <a
              href={item.href}
              class="nav__link"
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
              {item.children && <span class="nav__chevron" aria-hidden="true"></span>}
            </a>
            {item.children && (
              <div class="nav__sub">
                <ul>
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} aria-current={path === child.href ? 'page' : undefined}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="header-phone" href={CONTACT.phoneHref}>
        <Icon name="phone" size={18} class="header-phone__icon" />
        <span class="header-phone__text">
          <span class="header-phone__label">Telefon</span>
          <span class="header-phone__number">{CONTACT.phoneDisplay}</span>
        </span>
      </a>
      <button
        type="button"
        class="nav-toggle"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="nav-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="nav-toggle__text">Menü</span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden>
    <nav class="shell" aria-label="Navigation (mobil)">
      <ul class="mobile-nav__list">
        {MAIN_NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
            {item.children && (
              <ul class="mobile-nav__sub">
                {item.children.map((child) => (
                  <li><a href={child.href}>{child.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <div class="mobile-nav__contact">
        <a class="btn" href={CONTACT.phoneHref}>{CONTACT.phoneDisplay} anrufen</a>
        <a class="btn btn--secondary" href={CONTACT.whatsappHref} rel="noopener noreferrer" target="_blank">
          Kontakt per WhatsApp
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--stone);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    min-height: 78px;
    padding-block: 0.6rem;
  }

  .brand { display: inline-flex; flex: 0 0 auto; text-decoration: none; }
  .brand__logo {
    width: 132px;
    height: auto;
    aspect-ratio: 195 / 120;
  }

  /* --- Desktop navigation --- */
  .nav { display: none; margin-inline-start: auto; }
  .nav__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(0.35rem, 1.2vw, 1.1rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__item { position: relative; margin: 0; }
  .nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.35rem 0.6rem;
    border-radius: 8px;
    color: var(--ink);
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s var(--ease), color 0.15s var(--ease);
  }
  .nav__link:hover { background: var(--brand-wash); color: var(--brand-deep); }
  .nav__chevron {
    width: 7px;
    height: 7px;
    margin-left: 0.42rem;
    border-right: 1.8px solid currentColor;
    border-bottom: 1.8px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    opacity: 0.7;
    transition: transform 0.16s var(--ease);
  }
  .nav__item--has-sub:hover .nav__chevron,
  .nav__item--has-sub:focus-within .nav__chevron { transform: translateY(1px) rotate(-135deg); }
  .nav__link[aria-current='page'] {
    color: var(--brand-deep);
    box-shadow: inset 0 -2px 0 var(--brand);
  }

  .nav__sub {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 250px;
    padding-top: 0.5rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.16s var(--ease), transform 0.16s var(--ease), visibility 0.16s;
  }
  .nav__item--has-sub:hover .nav__sub,
  .nav__item--has-sub:focus-within .nav__sub {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .nav__sub ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem;
    background: var(--surface);
    border: 1px solid var(--stone);
    border-radius: 14px;
    box-shadow: var(--shadow-md);
  }
  .nav__sub li { margin: 0; }
  .nav__sub a {
    display: block;
    padding: 0.65rem 0.85rem;
    border-radius: 9px;
    color: var(--ink);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
  }
  .nav__sub a:hover { background: var(--brand-wash); color: var(--brand-deep); }

  /* --- Actions --- */
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-inline-start: auto;
  }
  .nav ~ .site-header__actions { margin-inline-start: 0; }

  .header-phone {
    display: none;
    align-items: center;
    gap: 0.55rem;
    line-height: 1.15;
    padding: 0.4rem 1.05rem 0.4rem 0.85rem;
    border-radius: 999px;
    text-decoration: none;
    color: var(--ink);
    background: var(--brand-wash);
    border: 1px solid var(--brand-wash-2);
    position: relative;
    min-height: 46px;
    justify-content: center;
  }
  .header-phone__icon { color: var(--brand-deep); flex: 0 0 auto; }
  .header-phone__text { display: flex; flex-direction: column; }
  .header-phone__label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-deep);
  }
  .header-phone__number { font-weight: 700; font-size: 1.02rem; }
  .header-phone:hover { background: var(--brand-wash-2); color: var(--ink); }

  /* --- Mobile toggle --- */
  .nav-toggle {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 46px;
    min-width: 46px;
    padding: 0.5rem 0.95rem;
    border: 1.5px solid #9a8a70;
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
  }
  .nav-toggle__bars { display: grid; gap: 4px; width: 18px; }
  .nav-toggle__bars span {
    display: block;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.2s var(--ease), opacity 0.2s var(--ease);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bars span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bars span:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bars span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  /* --- Mobile panel --- */
  .mobile-nav {
    border-top: 1px solid var(--stone);
    background: var(--paper-2);
    max-height: calc(100dvh - 78px);
    overflow-y: auto;
    padding-block: 1rem 1.6rem;
  }
  .mobile-nav__list { list-style: none; margin: 0 0 1.2rem; padding: 0; }
  .mobile-nav__list > li { margin: 0; border-bottom: 1px solid var(--stone-2); }
  .mobile-nav__list > li > a {
    display: block;
    padding: 0.95rem 0.25rem;
    font-size: 1.12rem;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
  }
  .mobile-nav__list > li > a[aria-current='page'] { color: var(--brand-deep); }
  .mobile-nav__sub { list-style: none; margin: 0 0 0.7rem; padding: 0 0 0 0.9rem; }
  .mobile-nav__sub li { margin: 0; }
  .mobile-nav__sub a {
    display: block;
    padding: 0.62rem 0.25rem;
    color: var(--ink-soft);
    font-weight: 600;
    text-decoration: none;
  }
  .mobile-nav__contact { display: grid; gap: 0.7rem; }

  @media (min-width: 900px) {
    .nav { display: block; }
    .nav-toggle { display: none; }
    .mobile-nav { display: none !important; }
    .header-phone { display: inline-flex; }
    .site-header__inner { min-height: 92px; }
    .brand__logo { width: 145px; }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');
  if (toggle && panel) {
    const close = () => {
      toggle.setAttribute('aria-expanded', 'false');
      panel.hidden = true;
    };
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        close();
        (toggle as HTMLButtonElement).focus();
      }
    });
    // Desktop breakpoint takes over: make sure nothing stays hidden/expanded.
    window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => {
      if (e.matches) close();
    });
  }
</script>
