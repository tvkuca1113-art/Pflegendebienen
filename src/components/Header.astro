---
import { MAIN_NAV, SECONDARY_NAV, SERVICE_NAV } from '../data/navigation';
import { CONTACT, BRAND } from '../data/business';
import { recruitmentEnabled } from '../config/site.mjs';
import Icon from './Icon.astro';

interface Props { path: string }
const { path } = Astro.props;

const secondary = SECONDARY_NAV.filter((i) => recruitmentEnabled || i.href !== '/karriere/');
const isActive = (href: string) =>
  path === href || (href !== '/' && path.startsWith(href.replace(/\/$/, '')));
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand" href="/" aria-label={`${BRAND.name} – zur Startseite`}>
      {/* Original logo, unmodified pixels, natural 195×120 ratio. */}
      <img src="/logo-original.png" width="195" height="120" alt={BRAND.name} class="brand__logo" />
    </a>

    <nav class="nav" aria-label="Hauptnavigation">
      <ul class="nav__list">
        {MAIN_NAV.map((item) => (
          <li>
            <a href={item.href} class="nav__link" aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <ul class="nav__list nav__list--secondary">
        {secondary.map((item) => (
          <li>
            <a href={item.href} class="nav__link nav__link--quiet" aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="header-phone" href={CONTACT.phoneHref}>
      <Icon name="phone" size={18} />
      <span>{CONTACT.phoneDisplay}</span>
    </a>

    <button type="button" class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="mobile-nav">
      <span class="nav-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
      <span>Menü</span>
    </button>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden>
    <nav class="shell" aria-label="Navigation">
      <ul class="mobile-nav__list">
        {MAIN_NAV.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
      <p class="mobile-nav__label" id="mobile-services">Leistungen</p>
      <ul class="mobile-nav__sub" aria-labelledby="mobile-services">
        {SERVICE_NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
      <ul class="mobile-nav__sub mobile-nav__sub--spaced">
        {secondary.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
      <a class="btn mobile-nav__call" href={CONTACT.phoneHref}>
        <Icon name="phone" size={19} />
        {CONTACT.phoneDisplay} anrufen
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--hairline);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: var(--header-h);
    padding-block: 0.5rem;
  }

  .brand { display: inline-flex; flex: 0 0 auto; }
  /* 104px keeps the 195:120 logo inside a 76px header with breathing room. */
  .brand__logo { width: 98px; height: auto; aspect-ratio: 195 / 120; }

  .nav { display: none; margin-inline-start: auto; }
  .nav__list { display: flex; align-items: center; gap: 0.15rem; list-style: none; margin: 0; padding: 0; }
  .nav__list li { margin: 0; }

  .nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.3rem 0.7rem;
    border-radius: 6px;
    color: var(--ink);
    font-size: 1.0625rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav__link:hover { background: var(--sage); color: var(--ink); }
  .nav__link[aria-current='page'] { box-shadow: inset 0 -2px 0 var(--brand); }

  .nav__list--secondary { margin-top: 0.1rem; }
  .nav__link--quiet { color: var(--olive); font-size: 0.9375rem; font-weight: 600; }
  .nav__link--quiet:hover { color: var(--ink); }

  .header-phone {
    display: none;
    align-items: center;
    gap: 0.45rem;
    min-height: 46px;
    padding: 0.4rem 0.95rem;
    border: 2px solid var(--line);
    border-radius: var(--radius);
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .header-phone:hover { background: var(--sage); color: var(--ink); }
  .header-phone svg { color: var(--brand-ink); flex: 0 0 auto; }

  .nav-toggle {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.5rem;
    min-height: 46px;
    min-width: 46px;
    margin-inline-start: auto;
    padding: 0.45rem 0.9rem;
    border: 2px solid var(--line);
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .nav-toggle__bars { display: grid; gap: 4px; width: 17px; }
  .nav-toggle__bars span { display: block; height: 2px; background: var(--ink); border-radius: 2px; transition: transform 0.18s var(--ease), opacity 0.18s var(--ease); }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bars span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bars span:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bars span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .mobile-nav {
    border-top: 1px solid var(--hairline);
    background: var(--surface);
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    padding-block: 0.75rem 1.5rem;
  }
  .mobile-nav__list { list-style: none; margin: 0 0 1rem; padding: 0; }
  .mobile-nav__list li { margin: 0; border-bottom: 1px solid var(--hairline); }
  .mobile-nav__list a {
    display: block;
    padding: 0.85rem 0.2rem;
    color: var(--ink);
    font-size: 1.125rem;
    font-weight: 700;
    text-decoration: none;
  }
  .mobile-nav__label {
    margin: 0 0 0.35rem;
    color: var(--olive);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .mobile-nav__sub { list-style: none; margin: 0 0 1rem; padding: 0; }
  .mobile-nav__sub li { margin: 0; }
  .mobile-nav__sub a {
    display: block;
    min-height: 44px;
    padding: 0.6rem 0.2rem;
    color: var(--ink-body);
    font-weight: 600;
    text-decoration: none;
  }
  .mobile-nav__sub--spaced { padding-top: 0.5rem; border-top: 1px solid var(--hairline); }
  .mobile-nav__call { width: 100%; }

  @media (min-width: 1000px) {
    :root { --header-h: 88px; }
    .site-header__inner { min-height: 88px; gap: 1.5rem; }
    .nav { display: block; }
    .nav-toggle { display: none; }
    .mobile-nav { display: none !important; }
    .header-phone { display: inline-flex; }
    .brand__logo { width: 128px; }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');
  if (toggle && panel) {
    const close = () => {
      toggle.setAttribute('aria-expanded', 'false');
      panel.hidden = true;
    };
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        close();
        (toggle as HTMLButtonElement).focus();
      }
    });
    window.matchMedia('(min-width: 1000px)').addEventListener('change', (e) => {
      if (e.matches) close();
    });
  }
</script>
