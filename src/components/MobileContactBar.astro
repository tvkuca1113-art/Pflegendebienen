---
import { CONTACT } from '../data/business';
import Icon from './Icon.astro';

/**
 * Appears only after the hero action has scrolled out of view, and hides again
 * whenever the contact section or another equivalent action is on screen, when
 * a field is focused (soft keyboard) or when printing.
 */
---

<div class="contact-bar" data-contact-bar hidden>
  <a class="contact-bar__btn contact-bar__btn--call" href={CONTACT.phoneHref}>
    <Icon name="phone" size={20} />
    <span>Anrufen</span>
  </a>
  <a class="contact-bar__btn" href={CONTACT.whatsappHref} target="_blank" rel="noopener noreferrer">
    <Icon name="whatsapp" size={20} />
    <span>Schreiben</span>
  </a>
</div>

<style>
  .contact-bar { display: none; }

  @media (max-width: 899px) {
    .contact-bar {
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: 90;
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: 0.5rem;
      padding: 0.55rem 0.75rem calc(0.55rem + env(safe-area-inset-bottom, 0px));
      background: color-mix(in srgb, var(--paper) 96%, transparent);
      backdrop-filter: blur(8px);
      border-top: 1px solid var(--hairline);
      transform: translateY(0);
      transition: transform 0.2s var(--ease);
    }
    .contact-bar[hidden] { display: none; }
    .contact-bar__btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      min-height: 50px;
      border: 2px solid var(--line);
      border-radius: var(--radius);
      background: var(--surface);
      color: var(--ink);
      font-weight: 700;
      text-align: center;
      text-decoration: none;
    }
    .contact-bar__btn--call { background: var(--brand); border-color: var(--brand); }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-contact-bar]');
  const heroCta = document.querySelector('[data-hero-cta]');
  const contactSection = document.getElementById('kontakt');

  if (bar && 'IntersectionObserver' in window) {
    let heroVisible = true;
    let contactVisible = false;
    let typing = false;

    const apply = () => {
      const show = !heroVisible && !contactVisible && !typing;
      bar.hidden = !show;
      // Reserve space only while the bar is actually on screen.
      document.body.style.paddingBottom = show
        ? 'calc(4.5rem + env(safe-area-inset-bottom, 0px))'
        : '';
    };

    if (heroCta) {
      new IntersectionObserver(([e]) => { heroVisible = e.isIntersecting; apply(); })
        .observe(heroCta);
    } else {
      heroVisible = false;
    }
    if (contactSection) {
      new IntersectionObserver(([e]) => { contactVisible = e.isIntersecting; apply(); },
        { rootMargin: '0px 0px -20% 0px' }).observe(contactSection);
    }

    // Never cover a focused control or an open soft keyboard.
    document.addEventListener('focusin', (e) => {
      const el = e.target as HTMLElement;
      typing = ['INPUT', 'TEXTAREA', 'SELECT'].includes(el.tagName);
      apply();
    });
    document.addEventListener('focusout', () => { typing = false; apply(); });

    apply();
  }
</script>
