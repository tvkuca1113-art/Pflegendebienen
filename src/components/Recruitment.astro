---
import Photo from './Photo.astro';
import { recruitmentEnabled } from '../config/site.mjs';

/** Kept behind one switch so the owner can remove the section, its menu entry
    and the route together. Candidate contact stays separate from care enquiries. */
---

{recruitmentEnabled && (
  <section class="jobs" aria-labelledby="jobs-title">
    <div class="shell jobs__inner">
      <figure class="jobs__figure">
        <Photo
          src="team-kaffeepause-instagram.webp"
          alt="Teammitglieder der Pflegenden Bienen bei einer gemeinsamen Kaffeepause"
          width={560}
          height={420}
          sizes="(min-width: 860px) 38vw, 100vw"
          class="jobs__image"
        />
      </figure>
      <div class="jobs__text">
        <span class="eyebrow">Arbeiten bei uns</span>
        <h2 id="jobs-title" class="jobs__title">Dein Können zählt.</h2>
        <p>Du möchtest Menschen zu Hause unterstützen?</p>
        <p>Lerne unser Team kennen und erzähl uns, welche Aufgabe du suchst.</p>
        <a class="btn btn--outline jobs__cta" href="/karriere/">Arbeiten bei uns</a>
      </div>
    </div>
  </section>
)}

<style>
  .jobs { background: var(--sage); padding-block: clamp(2rem, 4vw, 3.25rem); }
  .jobs__inner { display: grid; gap: clamp(1.25rem, 3vw, 2.5rem); align-items: center; }
  .jobs__figure { margin: 0; }
  .jobs__image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 18px 18px 18px 0;
  }
  .jobs__title { margin-bottom: 0.3em; font-size: var(--step-3); }
  .jobs__text p { max-width: 42ch; font-size: var(--step--1); margin-bottom: 0.5em; }
  .jobs__cta { margin-top: 1.1rem; }

  @media (min-width: 860px) {
    .jobs__inner { grid-template-columns: minmax(0, 0.72fr) minmax(0, 1fr); }
  }
</style>
