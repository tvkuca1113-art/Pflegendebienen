---
import { CONTACT } from '../data/business';
import Icon from './Icon.astro';

interface Props { title?: string; text?: string }
const {
  title = 'Persönlich besprechen',
  text = 'Am schnellsten klären wir Ihre Fragen im Gespräch. Sie müssen dafür nichts vorbereiten.',
} = Astro.props;
---

<aside class="contact-panel" aria-labelledby="contact-panel-title">
  <h2 id="contact-panel-title" class="contact-panel__title">{title}</h2>
  <p class="contact-panel__text">{text}</p>
  <div class="contact-panel__actions">
    <a class="btn" href={CONTACT.phoneHref}>
      <Icon name="phone" size={19} />
      {CONTACT.phoneDisplay}
    </a>
    <a class="btn btn--outline" href={CONTACT.whatsappHref} target="_blank" rel="noopener noreferrer">
      <Icon name="whatsapp" size={19} />
      WhatsApp
    </a>
  </div>
  <p class="contact-panel__mail">
    <Icon name="mail" size={17} />
    <a href={CONTACT.emailHref}>{CONTACT.email}</a>
  </p>
</aside>

<style>
  .contact-panel {
    background: linear-gradient(180deg, #fffdf8 0%, #fdf1de 100%);
    border: 1px solid var(--brand-edge);
    border-radius: var(--radius-lg);
    padding: clamp(1.3rem, 3vw, 1.9rem);
    position: sticky;
    top: 6.5rem;
  }
  .contact-panel__title { font-size: var(--step-1); margin-bottom: 0.45em; }
  .contact-panel__text { font-size: var(--step--1); color: var(--ink-body); margin-bottom: 1.3em; }
  .contact-panel__actions { display: grid; gap: 0.65rem; margin-bottom: 1.2rem; }
  .contact-panel__mail {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: var(--step--1);
    word-break: break-word;
  }
  .contact-panel__mail svg { color: var(--brand-ink); flex: 0 0 auto; }

  @media (max-width: 899px) { .contact-panel { position: static; } }
</style>
