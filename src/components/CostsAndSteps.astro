---
/**
 * Costs come before the owners: money is what visitors are unsure about.
 * No prices, no calculator, no entitlement claim and no benefit tables here —
 * the statutory detail with sources lives on /kosten-finanzierung/.
 */
const PILLARS = [
  {
    title: 'Pflegekasse',
    text: 'Zahlt bei anerkanntem Pflegegrad – für Pflege, Betreuung und Entlastung (SGB XI).',
  },
  {
    title: 'Krankenkasse',
    text: 'Zahlt ärztlich verordnete Behandlungspflege, etwa Wundversorgung (SGB V). Ohne Pflegegrad möglich.',
  },
  {
    title: 'Ihr Eigenanteil',
    text: 'Was darüber hinausgeht, zahlen Sie selbst. Wir rechnen es vorher gemeinsam durch.',
  },
];


const STEPS = [
  'Sie erzählen, was gebraucht wird.',
  'Wir besprechen Hilfe und Kosten.',
  'Wir klären, ob und wann es losgehen kann.',
];
---

<section class="costs section" id="kosten" aria-labelledby="costs-title">
  <div class="shell">
    <div class="costs__head">
      <h2 id="costs-title">Was zahlt die Kasse – und was bleibt für Sie?</h2>
      <p class="lead">
        Das hängt von der Hilfe, Ihrem Pflegegrad und einer möglichen Verordnung ab. Drei Töpfe
        kommen infrage:
      </p>
    </div>

    <dl class="costs__list">
      {PILLARS.map((p) => (
        <div class="costs__item reveal">
          <dt>{p.title}</dt>
          <dd>{p.text}</dd>
        </div>
      ))}
    </dl>

    <p class="costs__link">
      <a class="link-action" href="/kosten-finanzierung/">Kosten und Finanzierung im Detail</a>
    </p>

    <ol class="steps">
      {STEPS.map((step, i) => (
        <li class="steps__item">
          <span class="steps__num" aria-hidden="true">{i + 1}</span>
          <span>{step}</span>
        </li>
      ))}
    </ol>

  </div>
</section>

<style>
  .costs__head { margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem); }
  .costs__head h2 { max-width: 20ch; }
  .costs__head .lead { max-width: 44ch; }

  .costs__list { display: grid; gap: 1rem; margin: 0 0 1.75rem; }
  .costs__item {
    padding: clamp(1.1rem, 2.4vw, 1.5rem);
    border-radius: var(--radius);
    background: var(--sage);
  }
  .costs__item dt { margin-bottom: 0.35em; color: var(--ink); font-size: var(--step-1); font-weight: 700; }
  .costs__item dd { margin: 0; font-size: var(--step--1); }

  .costs__note { margin: 0 0 1rem; max-width: 62ch; font-size: var(--step--1); }
  .costs__link { margin: 0 0 clamp(2rem, 4vw, 3rem); }

  .steps {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: clamp(1.25rem, 3vw, 1.75rem) 0 0;
    border-top: 1px solid var(--hairline);
    list-style: none;
  }
  .steps__item { display: flex; align-items: center; gap: 0.85rem; margin: 0; font-weight: 600; color: var(--ink); }
  .steps__num {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--brand);
    color: var(--ink);
    font-size: 1rem;
    font-weight: 700;
  }


  @media (min-width: 760px) {
    .costs__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  }
</style>
