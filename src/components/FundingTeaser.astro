---
import { PILLARS } from '../data/funding';
---

<section class="section funding" aria-labelledby="funding-title">
  <div class="shell funding__inner">
    <div class="funding__head">
      <span class="eyebrow">Kosten</span>
      <h2 id="funding-title">Welche Kosten übernimmt die Kasse?</h2>
      <p class="lead">
        Das hängt von der Leistung, Ihrem Pflegegrad und gegebenenfalls einer ärztlichen Verordnung
        ab. Pflegekasse und Krankenkasse übernehmen unterschiedliche Aufgaben. Auch ein Eigenanteil
        kann entstehen.
      </p>
      <a class="btn funding__cta" href="/kosten-finanzierung/">Kosten und Finanzierung verstehen</a>
    </div>

    <dl class="funding__list">
      {PILLARS.map((p) => (
        <div class="funding__item reveal">
          <dt>{p.title}</dt>
          <dd>{p.short}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .funding { background: var(--paper-2); border-block: 1px solid var(--stone); }
  .funding__inner { display: grid; gap: clamp(2rem, 4vw, 3.5rem); align-items: start; }
  .funding__head { max-width: 48ch; }
  .funding__cta { margin-top: 1.6rem; }

  .funding__list { margin: 0; display: grid; gap: 1.15rem; }
  .funding__item {
    background: var(--surface);
    border: 1px solid var(--stone);
    border-radius: var(--radius);
    padding: 1.25rem 1.4rem;
  }
  .funding__item dt {
    font-weight: 700;
    font-size: var(--step-0);
    color: var(--brand-deep);
    margin-bottom: 0.35em;
  }
  .funding__item dd { margin: 0; color: var(--ink-soft); font-size: var(--step--1); }

  @media (min-width: 900px) {
    .funding__inner { grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); gap: 4rem; }
  }
</style>
