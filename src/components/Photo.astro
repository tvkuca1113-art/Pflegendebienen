---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Local photograph with explicit dimensions and modern derivatives.
 * The LCP hero passes `priority` so it is never lazy-loaded.
 */
interface Props {
  [key: string]: unknown;
  src: string;
  alt: string;
  width: number;
  height: number;
  sizes?: string;
  priority?: boolean;
  class?: string;
  /** Keeps faces visible when the frame is cropped. */
  position?: string;
}

const {
  src,
  alt,
  width,
  height,
  sizes = '(min-width: 900px) 50vw, 100vw',
  priority = false,
  class: cls = '',
  position = 'center',
  // Astro passes the parent's style scope (data-astro-cid-*) as a prop; it has
  // to be forwarded to the rendered <img> or scoped image styles never match.
  ...rest
} = Astro.props;

const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/**/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const key = Object.keys(modules).find((k) => k.endsWith('/' + src));
if (!key) throw new Error(`Photo not found in src/assets: ${src}`);
const image = modules[key]!.default;
---

<Image
  src={image}
  alt={alt}
  width={width}
  height={height}
  sizes={sizes}
  widths={[Math.round(width / 2), width, Math.min(width * 2, image.width)]}
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : 'auto'}
  class={cls}
  style={`object-position:${position}`}
  {...rest}
/>
