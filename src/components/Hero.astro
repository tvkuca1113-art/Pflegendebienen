---
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { CONTACT } from '../data/business';

/**
 * Mobile-first sizing based on what a phone actually shows. An iPhone 13
 * exposes 390 × 664 CSS px once the Safari toolbars are visible — not the
 * 844 px of the device's layout viewport. The hero is therefore capped with
 * `svh` (smallest viewport height) and deliberately ends before the fold, so
 * the next section peeks through instead of the photograph being sliced by
 * the browser chrome.
 *
 * Desktop keeps the editorial split: photograph edge to edge on its half,
 * text on solid paper. No text over the photograph — contrast stays at 14:1.
 */
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__grid">
    <div class="hero__text">
      <span class="eyebrow">Ambulante Pflege · München-West &amp; Germering</span>
      <h1 id="hero-title">Zuhause bleiben.<br />Pflege gemeinsam klären.</h1>
      <p class="lead hero__lead">
        Sie suchen Unterstützung für sich oder einen Angehörigen? Wir helfen bei der Pflege und im
        Alltag – und besprechen mit Ihnen, was jetzt gebraucht wird.
      </p>

      <div class="hero__actions">
        <a class="btn" href="#kontakt" data-hero-cta>Pflege anfragen</a>
        <a class="link-action" href="#hilfe">Welche Hilfe passt?</a>
      </div>

      <p class="hero__phone">
        Lieber direkt sprechen?
        <a href={CONTACT.phoneHref}>
          <Icon name="phone" size={18} />
          {CONTACT.phoneDisplay}
        </a>
      </p>
    </div>

    <figure class="hero__media">
      <Photo
        src="gespraech-zuhause.jpg"
        alt="Eine ältere Frau sitzt lächelnd im Wohnzimmer und spricht mit einer jüngeren Frau"
        width={1100}
        height={900}
        sizes="(min-width: 900px) 55vw, 100vw"
        priority={true}
        class="hero__image"
        position="58% 32%"
      />
      <figcaption class="hero__caption">KI-generiertes Symbolbild</figcaption>
    </figure>
  </div>

  <p class="hero__note">Sie müssen noch nicht wissen, welche Leistung die richtige ist.</p>
</section>

<style>
  .hero { background: var(--paper); border-bottom: 1px solid var(--hairline); }

  .hero__grid { display: grid; }

  .hero__text { padding-inline: var(--gutter); }

  .hero h1 { margin-bottom: 0.35em; }
  .hero__lead { max-width: 38ch; margin-bottom: 1.25em; }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem 1.4rem;
    margin-bottom: 0.9rem;
  }

  .hero__phone {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    color: var(--olive);
    font-size: var(--step--1);
  }
  .hero__phone a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    color: var(--ink);
    font-size: var(--step-0);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 2px solid var(--brand);
  }
  .hero__phone a:hover { color: var(--brand-ink); }
  .hero__phone svg { color: var(--brand-ink); }

  .hero__note {
    max-width: 42ch;
    margin: 0;
    padding-left: 0.85rem;
    border-left: 3px solid var(--brand);
    color: var(--olive);
    font-size: var(--step--1);
  }

  .hero__media { position: relative; margin: 0; overflow: hidden; background: var(--sage); min-height: 0; }
  .hero__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  .hero__caption {
    position: absolute;
    right: 0.65rem;
    bottom: 0.65rem;
    padding: 0.25rem 0.55rem;
    border-radius: 4px;
    background: rgba(34, 40, 33, 0.86);
    color: #ffffff;
    font-size: 0.75rem;
  }

  /* ---------------------------------------------------------------- mobile */
  @media (max-width: 899px) {
    /* Every pixel here buys height for the photograph, so the hero resolves
       with the next band visible instead of the image being cut mid-strip. */
    .hero .eyebrow { margin-bottom: 0.55rem; }
    .hero h1 { margin-bottom: 0.3em; }
    .hero__lead { font-size: 1.0625rem; line-height: 1.45; margin-bottom: 1rem; }
    .hero__actions { gap: 0.5rem 1.1rem; margin-bottom: 0.55rem; }

    .hero__grid {
      grid-template-rows: auto minmax(8rem, 1fr);
      /* Measured against the *smallest* viewport, so the Safari toolbars never
         slice the photograph. 2.5rem is left over on purpose: the note below
         peeks in and signals that the page continues. Content may grow past
         this — enlarged text must never be clipped. */
      min-height: calc(100svh - var(--header-h) - 2.5rem);
    }
    .hero__text { padding-block: 0.9rem 0.9rem; }
    /* The photograph takes whatever height is left: a real band on a tall
       phone, still present on a small one. */
    .hero__media { align-self: stretch; }
    .hero__note { margin-inline: var(--gutter); padding-block: 1.1rem 1.4rem; }
  }

  /* Very small phones (320–380 px): trade a little type size for a
     photograph that is actually present. */
  @media (max-width: 380px) {
    .hero h1 { font-size: 1.625rem; }
    .hero .eyebrow { font-size: 0.75rem; letter-spacing: 0.08em; }
    .hero__lead { font-size: 1rem; margin-bottom: 0.85rem; }
    .hero__text { padding-block: 0.75rem; }
  }

  /* --------------------------------------------------------------- desktop */
  @media (min-width: 900px) {
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
      grid-template-areas: 'text media' 'note media';
      grid-template-rows: 1fr auto;
      min-height: clamp(30rem, 68svh, 38rem);
    }
    /* Lets the text and the photograph join the section's own grid. */
    .hero__grid { display: contents; }
    .hero__text { grid-area: text; }
    .hero__media { grid-area: media; }
    .hero__note { grid-area: note; }
    .hero__text {
      display: flex;
      flex-direction: column;
      justify-content: center;
      /* Keeps the copy on the page grid while the panel bleeds to the edge. */
      padding-inline-start: max(var(--gutter), calc((100vw - var(--shell)) / 2 + var(--gutter)));
      padding-inline-end: clamp(2rem, 4vw, 3.5rem);
      padding-block: clamp(2.5rem, 5vw, 3.5rem) 0;
    }
    .hero__note {
      margin-inline-start: max(var(--gutter), calc((100vw - var(--shell)) / 2 + var(--gutter)));
      margin-inline-end: clamp(2rem, 4vw, 3.5rem);
      margin-block: 0 clamp(2.5rem, 5vw, 3.5rem);
    }
    .hero__caption { right: 1rem; bottom: 1rem; }
  }
</style>
