---
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { CONTACT } from '../data/business';

/**
 * Editorial split hero: the photograph runs edge to edge on its own half and
 * the text sits on solid warm paper that bleeds to the opposite edge. No
 * floating card, no scrim over faces, and no text on top of the photograph —
 * legibility for tired readers stays at full contrast.
 */
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__grid">
    <div class="hero__text">
      <span class="eyebrow">Ambulante Pflege · München-West &amp; Germering</span>
      <h1 id="hero-title">Zuhause bleiben.<br />Pflege gemeinsam klären.</h1>
      <p class="lead hero__lead">
        Sie suchen Unterstützung für sich oder einen Angehörigen? Wir helfen bei der Pflege und im
        Alltag – und besprechen mit Ihnen, was jetzt gebraucht wird.
      </p>

      <div class="hero__actions">
        <a class="btn" href="#kontakt" data-hero-cta>Pflege anfragen</a>
        <a class="link-action" href="#hilfe">Welche Hilfe passt?</a>
      </div>

      <p class="hero__phone">
        Lieber direkt sprechen?
        <a href={CONTACT.phoneHref}>
          <Icon name="phone" size={18} />
          {CONTACT.phoneDisplay}
        </a>
      </p>

      <p class="hero__note">Sie müssen noch nicht wissen, welche Leistung die richtige ist.</p>
    </div>

    <figure class="hero__media">
      <Photo
        src="gespraech-zuhause.jpg"
        alt="Eine ältere Frau sitzt lächelnd im Wohnzimmer und spricht mit einer jüngeren Frau"
        width={1100}
        height={900}
        sizes="(min-width: 900px) 55vw, 100vw"
        priority={true}
        class="hero__image"
        position="62% 38%"
      />
      <figcaption class="hero__caption">KI-generiertes Symbolbild</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero { background: var(--paper); border-bottom: 1px solid var(--hairline); }

  .hero__grid { display: grid; }

  /* Text keeps the page's left alignment even though its panel bleeds to the
     viewport edge. */
  .hero__text {
    padding-block: clamp(1.75rem, 4vw, 3.5rem) clamp(2rem, 4vw, 3.5rem);
    padding-inline: var(--gutter);
  }

  .hero h1 { margin-bottom: 0.4em; }
  .hero__lead { max-width: 38ch; margin-bottom: 1.5em; }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-bottom: 1.1rem;
  }

  .hero__phone {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.1rem;
    color: var(--olive);
    font-size: var(--step--1);
  }
  .hero__phone a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    color: var(--ink);
    font-size: var(--step-0);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 2px solid var(--brand);
  }
  .hero__phone a:hover { color: var(--brand-ink); }
  .hero__phone svg { color: var(--brand-ink); }

  .hero__note {
    max-width: 40ch;
    margin: 0;
    padding-left: 0.9rem;
    border-left: 3px solid var(--brand);
    color: var(--olive);
    font-size: var(--step--1);
  }

  /* --- Photograph: edge to edge, no card, no rounded box ----------------- */
  .hero__media { position: relative; margin: 0; background: var(--sage); }
  .hero__image { width: 100%; height: 100%; object-fit: cover; }

  .hero__caption {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    background: rgba(34, 40, 33, 0.86);
    color: #ffffff;
    font-size: 0.75rem;
    letter-spacing: 0.01em;
  }

  /* Mobile: text first, then the photograph as a full-bleed band. */
  @media (max-width: 899px) {
    .hero__image { aspect-ratio: 16 / 10; }
  }

  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
      align-items: stretch;
      /* Tall enough to carry the photograph, never a fixed height that could
         clip enlarged text. */
      min-height: clamp(30rem, 68vh, 38rem);
    }
    .hero__text {
      display: flex;
      flex-direction: column;
      justify-content: center;
      /* Aligns the copy with the rest of the page while the panel bleeds left. */
      padding-inline-start: max(var(--gutter), calc((100vw - var(--shell)) / 2 + var(--gutter)));
      padding-inline-end: clamp(2rem, 4vw, 3.5rem);
      padding-block: clamp(2.5rem, 5vw, 4rem);
    }
    .hero__caption { right: 1rem; bottom: 1rem; }
  }
</style>
