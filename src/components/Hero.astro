---
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { CONTACT } from '../data/business';

/**
 * One photographic scene, not two rectangles side by side. On desktop the
 * paper panel is set *into* the left edge of the photograph, which continues
 * above, below and behind it; a window-like rounded corner is the recurring
 * detail. The panel sits over the quiet left third of the picture, so no face
 * or hand is covered and the text keeps full contrast on solid paper.
 *
 * Height is content-driven. Mobile sizing is measured against `svh`, because
 * an iPhone 13 shows 390 × 664 CSS px once the Safari toolbars appear — not
 * the 844 of its layout viewport.
 */
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__scene">
    <div class="hero__canvas">
      <Photo
        src="gespraech-zuhause.jpg"
        alt="Eine ältere Frau sitzt lächelnd in ihrem Wohnzimmer und spricht mit einer jüngeren Frau"
        width={1400}
        height={1000}
        sizes="(min-width: 900px) 72vw, 100vw"
        priority={true}
        class="hero__image"
        position="66% 34%"
      />
    </div>

    <div class="hero__panel">
      <span class="eyebrow">Ambulante Pflege in München-West &amp; Germering</span>
      <h1 id="hero-title">Zuhause gut versorgt.<br class="hero__break" /> Als Familie entlastet.</h1>
      <p class="lead hero__lead">
        Wir unterstützen bei der Pflege und im Alltag. Gemeinsam finden wir heraus, welche Hilfe zu
        Ihrer Situation passt.
      </p>

      <div class="hero__actions">
        <a class="btn" href="#kontakt" data-hero-cta>Pflege anfragen</a>
        <a class="btn btn--outline" href="#hilfe">Passende Hilfe finden</a>
      </div>

      <p class="hero__phone">
        <a href={CONTACT.phoneHref}>
          <Icon name="phone" size={19} />
          {CONTACT.phoneDisplay}
        </a>
        <span>Rufen Sie uns an, wenn es schneller gehen soll.</span>
      </p>
    </div>
  </div>

  <p class="hero__note">
    <Icon name="check" size={18} />
    <span class="hero__note-text">
      Sie müssen noch nicht wissen, welche Unterstützung die richtige ist.
    </span>
    <span class="hero__credit">Symbolbild, KI-generiert</span>
  </p>
</section>

<style>
  .hero { background: var(--paper); }

  .hero__scene { position: relative; }

  .hero__canvas { position: relative; overflow: hidden; background: var(--sage); }
  .hero__image { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* The disclosure sits under the photograph, at the weight of a picture
     credit, so it informs without being pasted across the picture. */
  .hero__credit {
    margin: 0;
    color: var(--olive);
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  .hero__panel { background: var(--paper); }

  .hero h1 { margin-bottom: 0.35em; }
  .hero__break { display: none; }
  .hero__lead { max-width: 34ch; margin-bottom: 1.35em; }

  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-bottom: 1rem; }
  .hero__actions .btn { flex: 1 1 auto; }

  .hero__phone {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.7rem;
    margin: 0;
  }
  .hero__phone a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    color: var(--ink);
    font-size: var(--step-1);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 2px solid var(--brand);
  }
  .hero__phone a:hover { color: var(--brand-ink); }
  .hero__phone svg { color: var(--brand-ink); }
  .hero__phone span { color: var(--olive); font-size: var(--step--1); }

  .hero__note {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 0.9rem;
    margin: 0;
    padding: 1rem var(--gutter) 1.4rem;
    max-width: none;
    color: var(--olive);
    font-size: var(--step--1);
  }
  .hero__note svg { flex: 0 0 auto; color: var(--brand); align-self: flex-start; margin-top: 0.15em; }
  .hero__note-text { flex: 1 1 16rem; min-width: 0; }

  /* ---------------------------------------------------------------- mobile */
  @media (max-width: 899px) {
    .hero__scene { display: grid; grid-template-rows: auto minmax(8.5rem, 1fr); }
    .hero__panel { order: -1; padding: 1rem var(--gutter) 1.15rem; }
    .hero__canvas { align-self: stretch; }
    .hero__canvas .hero__image { position: absolute; inset: 0; }
    .hero__canvas { border-radius: 18px 18px 0 0; }

    /* Measured against the smallest viewport so the browser toolbars never cut
       the photograph, and short of full height so the next band peeks in. */
    .hero__scene { min-height: calc(100svh - var(--header-h) - 3.25rem); }

    .hero .eyebrow { margin-bottom: 0.5rem; }
    .hero h1 { margin-bottom: 0.3em; }
    .hero__lead { font-size: 1.0625rem; line-height: 1.45; margin-bottom: 1rem; max-width: none; }
    .hero__actions { gap: 0.55rem; margin-bottom: 0.75rem; }
    .hero__actions .btn { flex: 1 1 10rem; }
    .hero__phone { gap: 0.15rem 0.6rem; }
    .hero__phone span { flex-basis: 100%; }
  }

  @media (max-width: 380px) {
    .hero .eyebrow { font-size: 0.75rem; letter-spacing: 0.08em; }
    .hero__lead { font-size: 1rem; }
  }

  /* --------------------------------------------------------------- desktop */
  @media (min-width: 900px) {
    .hero { padding-block: clamp(1.5rem, 3vw, 2.75rem) 0; }

    .hero__scene {
      width: 100%;
      max-width: var(--shell);
      margin-inline: auto;
      padding-inline: var(--gutter);
      display: grid;
      /* The panel occupies the first track and the photograph spans both, so
         the picture continues behind and around the text. */
      grid-template-columns: minmax(24rem, 38rem) minmax(0, 1fr);
      grid-template-rows: auto;
      align-items: center;
    }

    .hero__canvas {
      grid-area: 1 / 1 / 2 / 3;
      /* Window-like frame: one generous rounded corner, the rest square. */
      border-radius: 28px 28px 28px 0;
      box-shadow: var(--shadow-photo);
      /* Taller than the panel on purpose: the picture has to breathe above and
         below the text, otherwise the two read as separate rectangles again. */
      min-height: clamp(30rem, 50vw, 40rem);
    }
    .hero__canvas .hero__image { position: absolute; inset: 0; }

    .hero__panel {
      grid-area: 1 / 1 / 2 / 2;
      position: relative;
      z-index: 1;
      /* Set into the photograph's left edge rather than beside it. */
      margin-inline-start: clamp(-1rem, -2vw, -2.25rem);
      margin-block: clamp(2rem, 4vw, 3.5rem);
      padding: clamp(1.75rem, 2.6vw, 2.5rem);
      border-radius: 22px 22px 22px 0;
      box-shadow: var(--shadow-panel);
    }

    .hero__break { display: inline; }

    .hero__note {
      max-width: var(--shell);
      margin-inline: auto;
      padding-block: 1.25rem 0;
    }
  }

  @media (min-width: 1200px) {
    .hero__scene { grid-template-columns: minmax(26rem, 40rem) minmax(0, 1fr); }
  }
</style>
