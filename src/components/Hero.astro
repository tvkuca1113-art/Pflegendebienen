---
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { CONTACT } from '../data/business';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="shell hero__inner">
    <div class="hero__text">
      <span class="eyebrow">Ambulante Pflege · München-West &amp; Germering</span>
      <h1 id="hero-title">Zuhause bleiben.<br />Pflege gemeinsam klären.</h1>
      <p class="lead hero__lead">
        Sie suchen Unterstützung für sich oder einen Angehörigen? Wir helfen bei der Pflege und im
        Alltag – und besprechen mit Ihnen, was jetzt gebraucht wird.
      </p>

      <div class="hero__actions">
        <a class="btn" href="#kontakt" data-hero-cta>Pflege anfragen</a>
        <a class="link-action" href="#hilfe">Welche Hilfe passt?</a>
      </div>

      <p class="hero__phone">
        Lieber direkt sprechen?
        <a href={CONTACT.phoneHref}>
          <Icon name="phone" size={18} />
          {CONTACT.phoneDisplay}
        </a>
      </p>

      <p class="hero__note">Sie müssen noch nicht wissen, welche Leistung die richtige ist.</p>
    </div>

    <figure class="hero__figure">
      <Photo
        src="gespraech-zuhause.jpg"
        alt="Eine ältere Frau sitzt lächelnd im Wohnzimmer und spricht mit einer jüngeren Frau"
        width={880}
        height={587}
        sizes="(min-width: 1000px) 56vw, 100vw"
        priority={true}
        class="hero__image"
        position="58% 34%"
      />
      <figcaption class="hero__caption">KI-generiertes Symbolbild</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero { background: var(--paper); border-bottom: 1px solid var(--hairline); }

  .hero__inner {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding-block: clamp(1.5rem, 4vw, 3.75rem) clamp(2.25rem, 5vw, 4.25rem);
    align-items: center;
  }

  .hero h1 { margin-bottom: 0.4em; }
  .hero__lead { max-width: 34ch; margin-bottom: 1.5em; }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-bottom: 1.1rem;
  }

  .hero__phone {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.1rem;
    color: var(--olive);
    font-size: var(--step--1);
  }
  .hero__phone a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    color: var(--ink);
    font-size: var(--step-0);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 2px solid var(--brand);
  }
  .hero__phone a:hover { color: var(--brand-ink); }
  .hero__phone svg { color: var(--brand-ink); }

  .hero__note {
    max-width: 40ch;
    margin: 0;
    padding-left: 0.9rem;
    border-left: 3px solid var(--brand);
    color: var(--olive);
    font-size: var(--step--1);
  }

  .hero__figure { margin: 0; }
  .hero__image {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }
  .hero__caption {
    margin-top: 0.5rem;
    color: var(--olive);
    font-size: 0.8125rem;
  }

  /* Text and the main action come before the photograph on small screens. */
  @media (max-width: 767px) {
    .hero__figure { order: 2; }
    .hero__image { aspect-ratio: 16 / 10; }
  }

  @media (min-width: 768px) {
    /* Asymmetric 5/7 composition. The text side carries the extra width so the
       headline reads in full phrases instead of breaking into short stubs. */
    .hero__inner { grid-template-columns: 7fr 5fr; gap: clamp(1.5rem, 3vw, 2.75rem); }
    .hero__lead { max-width: 40ch; }
  }
  @media (min-width: 1100px) {
    .hero__inner { grid-template-columns: 6.4fr 5.6fr; gap: 3.5rem; }
    .hero__image { aspect-ratio: 5 / 4; }
  }
</style>
