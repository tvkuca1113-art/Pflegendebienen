---
import type { FaqItem } from '../data/faq';

/**
 * Native details/summary: every answer is present in the rendered HTML,
 * keyboard operable without JavaScript and readable at 200% zoom.
 */
interface Props {
  items: readonly FaqItem[];
  title?: string;
  intro?: string;
  id?: string;
}
const { items, title = 'Fragen, die am Anfang häufig auftauchen.', intro, id = 'faq' } = Astro.props;
---

<section class="section faq" id={id} aria-labelledby={`${id}-title`}>
  <div class="shell faq__inner">
    <div class="faq__head">
      <span class="eyebrow">Häufige Fragen</span>
      <h2 id={`${id}-title`}>{title}</h2>
      {intro && <p class="lead">{intro}</p>}
    </div>

    <div class="faq__list">
      {items.map((item) => (
        <details class="faq__item">
          <summary class="faq__question">
            <span>{item.q}</span>
            <span class="faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="faq__answer"><p>{item.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__inner { display: grid; gap: clamp(1.75rem, 4vw, 3.5rem); align-items: start; }
  .faq__head { max-width: 40ch; }

  .faq__list {
    border-top: 1px solid var(--stone);
  }

  .faq__item { border-bottom: 1px solid var(--stone); }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 60px;
    padding: 1.05rem 0.25rem;
    font-weight: 700;
    font-size: var(--step-0);
    line-height: 1.4;
    cursor: pointer;
    list-style: none;
    color: var(--ink);
  }
  .faq__question::-webkit-details-marker { display: none; }
  .faq__question:hover { color: var(--brand-deep); }

  .faq__icon {
    position: relative;
    flex: 0 0 auto;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--brand-wash);
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 11px;
    height: 2px;
    margin: -1px 0 0 -5.5px;
    background: var(--brand-deep);
    border-radius: 2px;
    transition: transform 0.2s var(--ease);
  }
  .faq__icon::after { transform: rotate(90deg); }
  .faq__item[open] .faq__icon::after { transform: rotate(0deg); }
  .faq__item[open] .faq__question { color: var(--brand-deep); }

  .faq__answer {
    padding: 0 0 1.35rem;
    max-width: 68ch;
    color: var(--ink-soft);
  }

  @media (min-width: 900px) {
    .faq__inner { grid-template-columns: minmax(0, 0.62fr) minmax(0, 1.38fr); }
  }
</style>
