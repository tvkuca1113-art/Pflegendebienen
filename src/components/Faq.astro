---
import type { FaqItem } from '../data/faq';

/** Native details/summary: every answer is in the rendered HTML, keyboard
    operable without JavaScript and readable at 200% zoom. */
interface Props {
  items: readonly FaqItem[];
  title?: string;
  intro?: string;
  id?: string;
}
const { items, title = 'Häufige Fragen', intro, id = 'faq' } = Astro.props;
---

<section class="faq section section--line" id={id} aria-labelledby={`${id}-title`}>
  <div class="shell faq__inner">
    <div class="faq__head">
      <h2 id={`${id}-title`} class="faq__title">{title}</h2>
      {intro && <p class="faq__intro">{intro}</p>}
    </div>
    <div class="faq__list">
      {items.map((item) => (
        <details class="faq__item">
          <summary class="faq__q">
            <span>{item.q}</span>
            <span class="faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="faq__a"><p>{item.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__inner { display: grid; gap: clamp(1.5rem, 3vw, 3rem); align-items: start; }
  .faq__head { max-width: 34ch; }
  .faq__title { max-width: 16ch; }
  .faq__intro { margin: 0.9rem 0 0; color: var(--olive); font-size: var(--step--1); }

  .faq__list { border-top: 1px solid var(--hairline); }
  .faq__item { border-bottom: 1px solid var(--hairline); }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 56px;
    padding: 0.9rem 0.1rem;
    color: var(--ink);
    font-size: var(--step-0);
    font-weight: 700;
    line-height: 1.35;
    list-style: none;
    cursor: pointer;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q:hover { color: var(--brand-ink); }

  .faq__icon { position: relative; flex: 0 0 auto; width: 20px; height: 20px; }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 2px;
    margin: -1px 0 0 -7px;
    background: var(--brand-ink);
    transition: transform 0.18s var(--ease);
  }
  .faq__icon::after { transform: rotate(90deg); }
  .faq__item[open] .faq__icon::after { transform: rotate(0); }

  .faq__a { padding: 0 0 1.25rem; max-width: 62ch; font-size: var(--step--1); }

  @media (min-width: 900px) {
    .faq__inner { grid-template-columns: minmax(0, 0.55fr) minmax(0, 1.45fr); }
  }
</style>
