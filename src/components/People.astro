---
import Photo from './Photo.astro';
import { OWNERS } from '../data/business';
---

<section class="section people" aria-labelledby="people-title">
  <div class="shell people__inner">
    <div class="people__media reveal">
      <Photo
        src="marija-jelacic-bjelovuk.jpeg"
        alt="Marija Jelačić Bjelovuk, Inhaberin und Pflegedienstleitung der Pflegenden Bienen"
        width={620}
        height={620}
        sizes="(min-width: 900px) 42vw, 100vw"
        class="people__portrait"
      />
      <div class="people__badge">
        <span class="people__badge-name">{OWNERS.marija.name}</span>
        <span class="people__badge-role">{OWNERS.marija.role}</span>
      </div>
    </div>

    <div class="people__text">
      <span class="eyebrow">Inhaberinnen &amp; Inhaber</span>
      <h2 id="people-title">Lernen Sie die Menschen hinter den Pflegenden Bienen kennen.</h2>
      <p class="lead">{OWNERS.marija.experience}</p>

      <div class="people__second">
        <Photo
          src="dusko-bjelovuk.jpeg"
          alt="Duško Bjelovuk, Inhaber von Pflegende Bienen"
          width={168}
          height={168}
          sizes="84px"
          class="people__avatar"
        />
        <div>
          <h3 class="people__second-name">{OWNERS.dusko.name}</h3>
          <p class="people__second-role">{OWNERS.dusko.role}</p>
          <p class="people__second-text">{OWNERS.dusko.intro}</p>
        </div>
      </div>

      <a class="btn btn--secondary people__cta" href="/ueber-uns/">Mehr über unser Team</a>
    </div>
  </div>
</section>

<style>
  .people__inner { display: grid; gap: clamp(2rem, 4vw, 3.75rem); align-items: center; }

  .people__media { position: relative; }
  .people__portrait {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }
  .people__badge {
    position: absolute;
    left: clamp(0.75rem, 2vw, 1.5rem);
    bottom: clamp(0.75rem, 2vw, 1.5rem);
    right: clamp(0.75rem, 2vw, 1.5rem);
    display: grid;
    gap: 0.1rem;
    padding: 0.8rem 1.1rem;
    background: color-mix(in srgb, var(--paper) 93%, transparent);
    backdrop-filter: blur(8px);
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.7);
  }
  .people__badge-name { font-weight: 700; font-size: var(--step-0); }
  .people__badge-role { font-size: var(--step--1); color: var(--brand-deep); font-weight: 600; }

  .people__text { max-width: 56ch; }

  .people__second {
    display: flex;
    gap: 1.1rem;
    align-items: start;
    margin-top: 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--stone);
  }
  .people__avatar {
    flex: 0 0 auto;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    object-fit: cover;
  }
  .people__second-name { margin: 0 0 0.15em; font-size: var(--step-0); }
  .people__second-role {
    margin: 0 0 0.5em;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--brand-deep);
  }
  .people__second-text { margin: 0; color: var(--ink-soft); font-size: var(--step--1); }

  .people__cta { margin-top: 2rem; }

  @media (min-width: 900px) {
    .people__inner { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); }
  }
</style>
