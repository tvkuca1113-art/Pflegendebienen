---
import type { Crumb } from '../lib/schema';
interface Props { crumbs: Crumb[] }
const { crumbs } = Astro.props;
---

{crumbs.length > 1 && (
  <nav class="breadcrumbs" aria-label="Brotkrumennavigation">
    <ol>
      {crumbs.map((c, i) => (
        <li>
          {i < crumbs.length - 1 ? (
            <a href={c.path}>{c.name}</a>
          ) : (
            <span aria-current="page">{c.name}</span>
          )}
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
  .breadcrumbs { padding-block: 1.1rem 0; }
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.55rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9rem;
    color: var(--olive);
  }
  .breadcrumbs li { margin: 0; display: flex; align-items: center; gap: 0.55rem; }
  .breadcrumbs li + li::before { content: '/'; color: #b7a98f; }
  .breadcrumbs a { color: var(--ink-body); text-decoration: none; }
  .breadcrumbs a:hover { color: var(--brand-ink); text-decoration: underline; }
  .breadcrumbs [aria-current='page'] { color: var(--ink); font-weight: 600; }
</style>
