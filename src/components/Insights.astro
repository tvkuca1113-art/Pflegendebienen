---
import { INSIGHTS } from '../data/insights';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { SOCIAL } from '../data/business';
---

{/* Three curated posts, summarised in our own words, each linked to its public
    source. Not reviews, not proof of any clinical outcome, no embedded feed. */}
<section class="section insights" aria-labelledby="insights-title">
  <div class="shell">
    <div class="insights__head">
      <div>
        <span class="eyebrow">Einblicke</span>
        <h2 id="insights-title">Einblicke in unser Miteinander.</h2>
        <p class="lead">
          Drei Beiträge aus unseren öffentlichen Profilen – kurz zusammengefasst und jeweils mit
          Link zur Quelle.
        </p>
      </div>
      <a class="arrow-link insights__profile" href={SOCIAL.instagram} target="_blank" rel="noopener noreferrer">
        Profil auf Instagram
      </a>
    </div>

    <ul class="insights__grid">
      {INSIGHTS.map((post) => (
        <li class="insight reveal">
          <div class="insight__media">
            <Photo
              src={post.image}
              alt={post.alt}
              width={560}
              height={420}
              sizes="(min-width: 900px) 30vw, 100vw"
              class="insight__image"
            />
          </div>
          <div class="insight__body">
            <time class="insight__date" datetime={post.dateISO}>{post.dateDisplay}</time>
            <h3 class="insight__title">{post.title}</h3>
            <p class="insight__text">{post.text}</p>
            <a class="insight__link" href={post.sourceUrl} target="_blank" rel="noopener noreferrer">
              {post.sourceLabel}
              <Icon name="external" size={15} />
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .insights__head {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: end;
    justify-content: space-between;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .insights__head > div { max-width: 52ch; }
  .insights__profile { font-size: var(--step--1); }

  .insights__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem; }

  .insight {
    margin: 0;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--stone);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .insight__media { background: var(--stone-2); }
  .insight__image { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }

  .insight__body { padding: clamp(1.15rem, 2.4vw, 1.6rem); display: flex; flex-direction: column; gap: 0.5rem; flex: 1; }
  .insight__date {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-deep);
  }
  .insight__title { margin: 0; font-size: var(--step-1); }
  .insight__text { margin: 0; color: var(--ink-soft); font-size: var(--step--1); flex: 1; }
  .insight__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
    font-size: var(--step--1);
    font-weight: 600;
    min-height: 32px;
    align-self: flex-start;
  }

  @media (min-width: 820px) {
    .insights__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
