---
interface Props {
  title?: string;
  links: { label: string; href: string }[];
}
const { title = 'Passende Seiten', links } = Astro.props;
---

<nav class="related" aria-labelledby="related-title">
  <h2 id="related-title" class="related__title">{title}</h2>
  <ul class="related__list">
    {links.map((l) => (
      <li><a href={l.href} class="arrow-link">{l.label}</a></li>
    ))}
  </ul>
</nav>

<style>
  .related { padding-top: 2rem; border-top: 1px solid var(--stone); }
  .related__title {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 1rem;
  }
  .related__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 2rem;
  }
  .related__list li { margin: 0; }
  .related__list .arrow-link { font-size: var(--step--1); }
</style>
